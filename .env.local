mqtt.broker-url=${MQTT_BROKER_URL}
mqtt.client-id=${MQTT_CLIENT_ID}
mqtt.topic=${MQTT_TOPIC}

spring.data.mongodb.uri=${MONGODB_URI}
spring.data.mongodb.database=${MONGODB_DATABASE}
mongodb.collection.habitaciones=${MONGODB_COLLECTION_HABITACIONES}
mongodb.collection.mediciones=${MONGODB_COLLECTION_MEDICIONES}

# Configuraciones para Spring Boot
SPRING_PROFILES_ACTIVE=local

# Configuraciones para la API REST de habitaciones
ROOMS_API_PORT=8081
SPRING_DATA_MONGODB_DATABASE=Sensores
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017

# Configuraciones para la API REST de switches
SWITCHES_API_PORT=8091
SWITCHES_API_KEY=local-key
