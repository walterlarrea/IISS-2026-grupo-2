MQTT_BROKER_URL=tcp://localhost:1883
MQTT_CLIENT_ID=JavaSubscriber
MQTT_TOPIC="#"

MONGODB_DATABASE=Sensores
MONGODB_URI=mongodb://localhost:27017
MONGODB_COLLECTION_HABITACIONES="Habitaciones"
MONGODB_COLLECTION_MEDICIONES="Mediciones"

# Configuraciones para Spring Boot
SPRING_PROFILES_ACTIVE=local

# Configuraciones para la API REST del Controlador
CONTROLADOR_API_PORT=8081
CONTROLADOR_API_URL=http://localhost:8081
CONTROLADOR_API_KEY=local-controlador-key
#SPRING_DATA_MONGODB_DATABASE=Sensores
#SPRING_DATA_MONGODB_URI=mongodb://localhost:27017

# Configuraciones para la API REST de switches
SWITCHES_API_PORT=8091
SWITCHES_API_KEY=local-key

# Integración opcional con el simulador; completar URL y clave para habilitarla.
CONECTAR_CON_SIMULADOR=true
SIMULATOR_API_URL=http://localhost:9090
SIMULATOR_API_KEY=development-key
CONTROLADOR_ETIQUETA=controlador

REGISTRATION_RETRY_MS=5000