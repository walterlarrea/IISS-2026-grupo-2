MQTT_BROKER_URL=tcp://mosquitto:1883
MQTT_CLIENT_ID=EcoWarmControlador
MQTT_TOPIC="#"

MONGODB_DATABASE=Sensores
MONGODB_URI=mongodb://mongodb:27017
MONGODB_COLLECTION_HABITACIONES="Habitaciones"
MONGODB_COLLECTION_MEDICIONES="Mediciones"

# Configuraciones para Spring Boot
SPRING_PROFILES_ACTIVE=development
APP_LOG_LEVEL=INFO

# Configuraciones para la API REST del Controlador
CONTROLADOR_API_PORT=8080
CONTROLADOR_API_URL=http://controller:8080
CONTROLADOR_API_KEY=development-key
#SPRING_DATA_MONGODB_DATABASE=Sensores
#SPRING_DATA_MONGODB_URI=mongodb://mongodb:27017

# Configuraciones para la API REST de switches
SWITCHES_API_PORT=8090
SWITCHES_API_KEY=iiss-2026

# Integración opcional con el simulador; completar URL y clave para habilitarla.
CONECTAR_CON_SIMULADOR=false
SIMULATOR_API_URL=http://host.docker.internal:9090
SIMULATOR_API_KEY=iiss-2026
CONTROLADOR_ETIQUETA=equipo-2
CONTROLADOR_PUBLIC_API_URL=http://localhost:8080

REGISTRATION_RETRY_MS=5000
CONTROLADOR_INERCIA_TERMICA_C=0.1
CONTROLADOR_ESPERA_MAXIMA_MIN=60
CONTROLADOR_MINIMO_ENCENDIDA_MIN=10
CONTROLADOR_HISTERESIS_ENCENDIDO_C=0.3

# Configuración para "deshabilitar" la inercia térmica, el tiempo de espera máximo, histeresis y el tiempo mínimo de encendido.
# CONTROLADOR_INERCIA_TERMICA_C=0.0
# CONTROLADOR_ESPERA_MAXIMA_MIN=1000000
# CONTROLADOR_MINIMO_ENCENDIDA_MIN=0
# CONTROLADOR_HISTERESIS_ENCENDIDO_C=0.0